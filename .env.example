# Roboflow API Configuration
# Get your API key from: https://roboflow.com/
# 1. Create a Roboflow account
# 2. Go to your workspace settings
# 3. Copy your Private API Key
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# Roboflow Workspace Names
# Get these from your forked workflows:
# 1. Fork the Troop Detection workflow and get the workspace name
# 2. Fork the Card Detection workflow and get the workspace name
WORKSPACE_TROOP_DETECTION=workspace-your-troop-detection-name
WORKSPACE_CARD_DETECTION=workspace-your-card-detection-name

# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace 'your_roboflow_api_key_here' with your actual Roboflow API key
# 3. Replace the workspace names with your actual forked workspace names
# 4. Keep your .env file private and never commit it to version control

# Optional runtime configuration
# Use entire primary display for calibration (ignores WINDOW_TITLE)
# Set to 1 to enable fullscreen mode
FULLSCREEN=0

# If not using fullscreen, optionally set exact BlueStacks window title
# WINDOW_TITLE=BlueStacks 5

# Manual region overrides (pixels) if auto-calibration fails
# FIELD_TOP_LEFT_X=
# FIELD_TOP_LEFT_Y=
# FIELD_BOTTOM_RIGHT_X=
# FIELD_BOTTOM_RIGHT_Y=
# CARD_BAR_X=
# CARD_BAR_Y=
# CARD_BAR_WIDTH=
# CARD_BAR_HEIGHT=